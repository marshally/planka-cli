#!/usr/bin/env ruby
# Prints built-in agent instructions without connecting to Planka.
require "planka/workflow"
require "planka/cli"

options = {}
parser = Planka::CLI.output_parser(options, "usage: planka prime [--output human|json]")
parser.separator "Canonical replacement: planka workflow guide"
Planka::CLI.parse!(parser, "planka prime")
abort parser.banner unless ARGV.empty?

Planka::CLI.emit({ "instructions" => Planka::Workflow::Prime::INSTRUCTIONS },
                 output: options[:output], human: Planka::Workflow::Prime::INSTRUCTIONS)
