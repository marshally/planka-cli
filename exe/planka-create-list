#!/usr/bin/env ruby
# Creates a column (list) on a board, appended after the existing columns.
#
#   planka create-list --name NAME [--board ID] [--type active|closed] [--position N]
#
# The board defaults to PLANKA_BOARD_ID. A new board has no columns; create the
# conventional ones (ready-for-agent, in-progress, done) before adding cards.
require "planka"
require "planka/client"
require "optparse"

options = { type: "active" }
parser = OptionParser.new do |o|
  o.banner = "usage: planka create-list --name NAME [--board ID] [--type active|closed] [--position N]"
  o.on("--name NAME", "list name") { |v| options[:name] = v }
  o.on("--board ID", "board id (default PLANKA_BOARD_ID)") { |v| options[:board] = v }
  o.on("--type TYPE", "active or closed (default active)") { |v| options[:type] = v }
  o.on("--position N", Integer, "explicit position") { |v| options[:position] = v }
end
Planka::CLI.parse!(parser, "planka-create-list")

Planka::CLI.run("planka-create-list") do |client|
  name = options.fetch(:name) { raise Planka::Error, "--name is required" }
  board_id = Planka::CLI.board_id(options[:board])
  Planka::CLI.emit(Planka::Lists.new(client).create(board_id:, name:, type: options[:type], position: options[:position]))
end
