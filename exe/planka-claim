#!/usr/bin/env ruby
# Claims a card for the signed-in user: makes it a card member, then moves the
# card to its board's in-progress list. Safe to re-run.
#
#   planka claim <card>     an id or card URL
#
# Runs as the user configured in PLANKA_AGENT_EMAIL.
require "planka/workflow"
require "planka/cli"
require "planka/client"

options = {}
parser = Planka::CLI.output_parser(options, "usage: planka claim <card> [--output human|json]")
Planka::CLI.parse!(parser, "planka claim")
abort parser.banner unless ARGV.size == 1

begin
  card_id = Planka.card_id(ARGV.first)

  Planka::Client.session do |client|
    result = Planka::Workflow::Claim.call(client, card_id, base_url: ENV.fetch("PLANKA_BASE_URL"))
    Planka::CLI.emit(result.data, output: options[:output], human: "claimed: #{result.card}")
  end
rescue Planka::Error, KeyError => e
  abort "planka claim: #{e.message}"
end
