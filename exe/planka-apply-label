#!/usr/bin/env ruby
# Applies a label to a card, by label id or exact label name resolved within the
# card's board. Existing labels are preserved and re-applying is safe.
#
#   planka apply-label <card> --label ID|NAME
require "planka"
require "planka/cli"
require "planka/client"
require "optparse"

options = {}
parser = OptionParser.new do |o|
  o.separator "Canonical replacement: planka add label LABEL --card CARD"
  o.banner = "usage: planka apply-label <card> --label ID|NAME [--output human|json]"
  o.on("--label LABEL", "label id or exact name") { |v| options[:label] = v }
  Planka::CLI.output_option(o, options)
end
Planka::CLI.parse!(parser, "planka apply-label")

abort parser.banner unless ARGV.size == 1

Planka::CLI.run("planka apply-label", output: options[:output]) do |client|
  label = options.fetch(:label) { raise Planka::Error, "--label is required" }
  result = Planka::Labels.new(client).apply(card_id: Planka.card_id(ARGV.first), label:)
  Planka::CLI.emit(result, output: options[:output], human: Planka::CLI.label_application(result))
end
