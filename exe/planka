#!/usr/bin/env ruby
require "planka-cli"
require "planka/canonical_cli"

commands = %w[prime link next-card branch-name claim comment unticked spec-sweep loop-lock
  snapshot show create-list create-spec create-ticket update-card move-card labels
  create-label apply-label create-task-list rename-task-list]
if ARGV == ["--version"]
  puts Planka::VERSION
elsif ARGV.empty? || ARGV == ["--help"] || ARGV == ["-h"]
  puts Planka::CanonicalCLI.root_help(commands)
elsif !commands.include?(ARGV.first)
  Planka::CanonicalCLI.run(ARGV, legacy_commands: commands)
else
  command = ARGV.shift
  abort "planka: unknown command #{command.inspect}; see planka --help" unless commands.include?(command)
  load File.expand_path("planka-#{command}", __dir__)
end
