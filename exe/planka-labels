#!/usr/bin/env ruby
# Lists a board's labels with their ids, names, colors and positions, read from
# the board snapshot (the authoritative source for labels). Read-only.
#
#   planka labels [--board ID]     board defaults to PLANKA_BOARD_ID
require "planka"
require "planka/client"
require "optparse"

options = {}
parser = OptionParser.new do |o|
  o.banner = "usage: planka labels [--board ID] [--output human|json]"
  o.on("--board ID", "board id (default PLANKA_BOARD_ID)") { |v| options[:board] = v }
  Planka::CLI.output_option(o, options)
end
Planka::CLI.parse!(parser, "planka labels")

Planka::CLI.run("planka labels", output: options[:output]) do |client|
  board_id = Planka::CLI.board_id(options[:board])
  result = { "boardId" => board_id, "labels" => Planka::Labels.new(client).list(board_id) }
  Planka::CLI.emit(result, output: options[:output], human: Planka::CLI.labels(result))
end
