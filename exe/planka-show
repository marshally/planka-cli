#!/usr/bin/env ruby
# Reads one card: description, board and list identity, labels, members, named
# task lists with their tasks, linked blockers and comments. Read-only.
#
#   planka show <card>     an id or card URL
require "planka"
require "planka/cli"
require "planka/cli/resources/cards"
require "planka/client"
require "optparse"

options = {}
parser = OptionParser.new do |o|
  o.banner = "usage: planka show <card> [--output human|json]"
  o.separator "Canonical replacement: planka describe card CARD (same human output; new JSON envelope)."
  Planka::CLI.output_option(o, options)
end
Planka::CLI.parse!(parser, "planka show")

abort parser.banner unless ARGV.size == 1

Planka::CLI.run("planka show", output: options[:output]) do |client|
  detail = Planka::Cards::Detail.new(client).for(Planka.card_id(ARGV.first))
  Planka::CLI.emit(detail, output: options[:output], human: Planka::CLI::Resources::Cards.format(detail))
end
