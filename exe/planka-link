#!/usr/bin/env ruby
# Records blocking edges between Planka cards as linked tasks, which the
# planka MCP server cannot create.
#
#   planka link <blocked-card> <blocker-card> [<blocker-card>...]
#
# Cards are ids or card URLs. Each blocker becomes a task linked to that card
# in a "Blocked by" task list on the blocked card. Re-running is safe: blockers
# already linked are skipped. The logic lives in lib/planka/workflow/blocking.rb.
require "planka/workflow"
require "planka/cli"
require "planka/client"

options = {}
parser = Planka::CLI.output_parser(options, "usage: planka link <blocked-card> <blocker-card> [<blocker-card>...] [--output human|json]")
Planka::CLI.parse!(parser, "planka link")
abort parser.banner if ARGV.size < 2

begin
  blocked, *blockers = ARGV.map { |arg| Planka.card_id(arg) }

  Planka::Client.session do |client|
    lines = Planka::Workflow::Blocking.new(client).link(blocked, blockers)
    links = blockers.uniq.zip(lines).map do |blocker, line|
      {
        "blockerCardId" => blocker,
        "status" => line.start_with?("already linked:") ? "already-linked" : "linked",
        "closed" => line.end_with?("(closed)"),
      }
    end
    Planka::CLI.emit({ "blockedCardId" => blocked, "links" => links }, output: options[:output], human: lines.join("\n"))
  end
rescue Planka::Error, KeyError => e
  abort "planka link: #{e.message}"
end
