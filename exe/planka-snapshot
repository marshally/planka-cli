#!/usr/bin/env ruby
# Reads a board: lists, cards, labels, card-label associations, task lists,
# tasks and card memberships. JSON output retains identifiers, positions, list
# types and descriptions. Cards gain a url and are ordered by position.
#
#   planka snapshot [--board ID] [--list ID|NAME]
#
# With --list, prints only that list's cards, by id or name. The board defaults
# to PLANKA_BOARD_ID.
require "planka"
require "planka/client"
require "optparse"

options = {}
parser = OptionParser.new do |o|
  o.banner = "usage: planka snapshot [--board ID] [--list ID|NAME] [--output human|json]"
  o.on("--board ID", "board id (default PLANKA_BOARD_ID)") { |v| options[:board] = v }
  o.on("--list LIST", "only this list's cards, by id or name") { |v| options[:list] = v }
  Planka::CLI.output_option(o, options)
end
Planka::CLI.parse!(parser, "planka-snapshot")

Planka::CLI.run("planka-snapshot", output: options[:output]) do |client|
  board_id = Planka::CLI.board_id(options[:board])
  included = client.board(board_id)
  snapshot = Planka::Snapshot.new(included)

  if options[:list]
    list = options[:list]
    list_id = list.match?(/\A\d+\z/) ? list : Planka::Board.new(included).list_id(list)
    result = { "boardId" => board_id, "listId" => list_id, "cards" => snapshot.cards_in(list_id) }
  else
    result = { "boardId" => board_id }.merge(snapshot.to_h)
  end
  Planka::CLI.emit(result, output: options[:output], human: Planka::CLI.board_snapshot(result))
end
