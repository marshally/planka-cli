#!/usr/bin/env ruby
# Reads a board as machine-readable JSON: lists, cards, labels, card-label
# associations, task lists, tasks and card memberships, with identifiers,
# positions, list types and descriptions retained. Cards gain a url and are
# ordered by position. Read-only.
#
#   planka snapshot [--board ID] [--list ID|NAME]
#
# With --list, prints only that list's cards, by id or name. The board defaults
# to PLANKA_BOARD_ID.
require "planka"
require "planka/client"
require "optparse"

options = {}
parser = OptionParser.new do |o|
  o.banner = "usage: planka snapshot [--board ID] [--list ID|NAME]"
  o.on("--board ID", "board id (default PLANKA_BOARD_ID)") { |v| options[:board] = v }
  o.on("--list LIST", "only this list's cards, by id or name") { |v| options[:list] = v }
end
Planka::CLI.parse!(parser, "planka-snapshot")

Planka::CLI.run("planka-snapshot") do |client|
  board_id = Planka::CLI.board_id(options[:board])
  included = client.board(board_id)
  snapshot = Planka::Snapshot.new(included)

  if options[:list]
    list = options[:list]
    list_id = list.match?(/\A\d+\z/) ? list : Planka::Board.new(included).list_id(list)
    Planka::CLI.emit("boardId" => board_id, "listId" => list_id, "cards" => snapshot.cards_in(list_id))
  else
    Planka::CLI.emit({ "boardId" => board_id }.merge(snapshot.to_h))
  end
end
